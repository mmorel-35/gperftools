	$(MAKE) $(MAKESILENT) -f CMakeFiles/binary_trees.dir/build.make CMakeFiles/binary_trees.dir/benchmark/binary_trees.cc.o
	$(MAKE) $(MAKESILENT) -f CMakeFiles/binary_trees_shared.dir/build.make CMakeFiles/binary_trees_shared.dir/benchmark/binary_trees.cc.o
.PHONY : benchmark/binary_trees.cc.o

benchmark/binary_trees.i: benchmark/binary_trees.cc.i
.PHONY : benchmark/binary_trees.i

# target to preprocess a source file
benchmark/binary_trees.cc.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/binary_trees.dir/build.make CMakeFiles/binary_trees.dir/benchmark/binary_trees.cc.i
	$(MAKE) $(MAKESILENT) -f CMakeFiles/binary_trees_shared.dir/build.make CMakeFiles/binary_trees_shared.dir/benchmark/binary_trees.cc.i
.PHONY : benchmark/binary_trees.cc.i

benchmark/binary_trees.s: benchmark/binary_trees.cc.s
.PHONY : benchmark/binary_trees.s

# target to generate assembly for a file
